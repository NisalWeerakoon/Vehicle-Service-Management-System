<Project Sdk="Microsoft.NET.Sdk">
 
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
 
  <ItemGroup>
    <!-- Test framework -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
 
    <!-- Assertion library (readable, chainable asserts) -->
    <PackageReference Include="FluentAssertions" Version="6.12.1" />
 
    <!-- Spins up the real ASP.NET Core pipeline in-memory for integration tests -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
 
    <!-- Lets us swap the real MySQL provider for a fast, disposable SQLite DB in tests -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
  </ItemGroup>
 
  <ItemGroup>
    <!-- Point this at the real service project so we test the actual production code -->
    <ProjectReference Include="..\..\services\CustomerBookingService\CustomerBookingService.csproj" />
  </ItemGroup>
 
</Project>
